<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-equipment.svg" alt="" class="page-header-icon">Equipment Maintenance Scheduler &amp; Fleet Inventory</h1>
                <p class="page-header-subtitle">Heavy machinery tracking, service schedules, and operational status.</p>
            </div>
            <% if (user && user.role !== 'Vendor') { %>
                <div class="header-actions">
                    <a href="/equipment/create" class="btn btn-secondary">+ Register Machinery</a>
                    <a href="/equipment/schedule" class="btn btn-primary">+ Schedule Maintenance</a>
                </div>
            <% } %>
        </div>

        <!-- Section 1: Maintenance Schedule & Alerts Calendar -->
        <div class="card" style="margin-bottom: 2rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <h3>🔧 Active & Upcoming Maintenance Schedule</h3>
                <span class="status-badge status-good">Preventive & Routine Workflows</span>
            </div>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Equipment / Machine</th>
                            <th>Type & Description</th>
                            <th>Assigned Specialist</th>
                            <th>Est. Cost</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (maintenance && maintenance.length > 0) { %>
                            <% maintenance.forEach(ms => { %>
                                <tr>
                                    <td><strong><%= new Date(ms.scheduled_date).toLocaleDateString() %></strong></td>
                                    <td>
                                        <strong><%= ms.equipment_name %></strong> <br>
                                        <small style="color: var(--text-muted);"><%= ms.equipment_code %> (<%= ms.project_name || 'In Depot' %>)</small>
                                    </td>
                                    <td>
                                        <span class="status-badge status-good" style="font-size: 0.75rem;"><%= ms.maintenance_type %></span><br>
                                        <span style="font-size: 0.9rem;"><%= ms.description %></span>
                                    </td>
                                    <td><%= ms.assigned_to || 'Internal Mechanics' %></td>
                                    <td>৳<%= parseFloat(ms.cost_estimate || 0).toLocaleString() %></td>
                                    <td>
                                        <%
                                            // 'In Progress' and 'Overdue' were sharing the same red/danger badge —
                                            // making a mechanic actively on the job look exactly as alarming as a
                                            // task that's genuinely late. In Progress is a normal, fine state and
                                            // belongs with Scheduled's calm blue; only Overdue should read as red.
                                            let msBadgeClass = 'status-ongoing'; // Scheduled (default)
                                            if (ms.status === 'Completed') msBadgeClass = 'status-good';
                                            else if (ms.status === 'Overdue') msBadgeClass = 'status-critical';
                                            else if (ms.status === 'In Progress') msBadgeClass = 'status-info';
                                        %>
                                        <span class="status-badge <%= msBadgeClass %>">
                                            <%= ms.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (user && user.role !== 'Vendor' && ms.status !== 'Completed') { %>
                                            <form action="/equipment/maintenance/<%= ms.id %>/status" method="POST" style="display: inline-block;">
                                                <input type="hidden" name="equipment_id" value="<%= ms.equipment_id %>">
                                                <% if (ms.status === 'Scheduled' || ms.status === 'Overdue') { %>
                                                    <input type="hidden" name="status" value="In Progress">
                                                    <button type="submit" class="btn btn-secondary btn-xs">Start Work</button>
                                                <% } else if (ms.status === 'In Progress') { %>
                                                    <input type="hidden" name="status" value="Completed">
                                                    <button type="submit" class="btn btn-success btn-xs">Mark Complete & ✓ Operational</button>
                                                <% } %>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">No maintenance tasks currently scheduled or in progress.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Heavy Machinery & Fleet Inventory Directory -->
        <div class="card">
            <h3>🚜 Heavy Machinery & Construction Equipment Directory</h3>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Equipment Name</th>
                            <th>Category</th>
                            <th>Current Project Deployment</th>
                            <th>Operational Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (equipment && equipment.length > 0) { %>
                            <% equipment.forEach(eq => { %>
                                <%
                                    let eqIcon = 'equip-default.svg';
                                    const cat = (eq.category || '').toLowerCase();
                                    if (cat.includes('crane')) eqIcon = 'equip-crane.svg';
                                    else if (cat.includes('mixer')) eqIcon = 'equip-mixer.svg';
                                    else if (cat.includes('generator')) eqIcon = 'equip-generator.svg';
                                    else if (cat.includes('excavator') || cat.includes('heavy machinery')) eqIcon = 'equip-excavator.svg';
                                %>
                                <tr>
                                    <td><strong><%= eq.equipment_code %></strong></td>
                                    <td>
                                        <div class="row-with-icon">
                                            <img src="/images/<%= eqIcon %>" alt="<%= eq.category %>" class="icon-badge">
                                            <%= eq.name %>
                                        </div>
                                    </td>
                                    <td><%= eq.category %></td>
                                    <td><%= eq.project_name || 'Central Depot / Available' %></td>
                                    <td>
                                        <span class="status-badge <%= eq.status === 'Operational' || eq.status === 'Available' ? 'status-good' : 'status-lowstock' %>">
                                            <%= eq.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <% if (user && user.role !== 'Vendor') { %>
                                                <a href="/equipment/schedule?equipment_id=<%= eq.id %>" class="btn btn-secondary btn-xs">+ Schedule Service</a>
                                            <% } %>
                                            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                                <a href="/equipment/edit/<%= eq.id %>" class="btn btn-secondary btn-xs">Edit</a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6" style="text-align: center; padding: 2rem;">No heavy machinery registered in fleet. Click "+ Register Machinery".</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
