<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <h2>Edit Equipment Asset</h2>
            <a href="/equipment" class="btn btn-secondary">&larr; Back to Equipment Directory</a>
        </div>

        <div class="card" style="max-width: 730px; margin: 0 auto;">
            <form action="/equipment/edit/<%= equipment.id %>" method="POST">
                <div class="grid-2">
                    <div class="form-group">
                        <label for="name">Machine / Equipment Name:</label>
                        <input type="text" name="name" id="name" class="form-control" required value="<%= equipment.name %>">
                    </div>
                    <div class="form-group">
                        <label for="equipment_code">Unique Asset Code / Tag:</label>
                        <input type="text" name="equipment_code" id="equipment_code" class="form-control" required value="<%= equipment.equipment_code %>">
                    </div>
                </div>

                <div class="grid-2" style="margin-top: 1rem;">
                    <div class="form-group">
                        <label for="category">Equipment Category:</label>
                        <select name="category" id="category" class="form-control" required>
                            <% const categories = ['Cranes', 'Mixers', 'Power Generators', 'Heavy Machinery', 'Tools']; %>
                            <% categories.forEach(c => { %>
                                <option value="<%= c %>" <%= equipment.category === c ? 'selected' : '' %>><%= c %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="current_project_id">Current Site Deployment:</label>
                        <select name="current_project_id" id="current_project_id" class="form-control">
                            <option value="">-- Central Depot (Unassigned) --</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>" <%= equipment.current_project_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="grid-2" style="margin-top: 1rem;">
                    <div class="form-group">
                        <label for="status">Operational Status:</label>
                        <select name="status" id="status" class="form-control" required>
                            <% const statuses = ['Operational', 'Available', 'In Use', 'Under Maintenance', 'Out of Service', 'Decommissioned']; %>
                            <% statuses.forEach(s => { %>
                                <option value="<%= s %>" <%= equipment.status === s ? 'selected' : '' %>><%= s %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="purchase_date">Acquisition / Purchase Date:</label>
                        <input type="date" name="purchase_date" id="purchase_date" class="form-control" value="<%= equipment.purchase_date ? toDateInputValue(equipment.purchase_date) : '' %>">
                    </div>
                </div>

                <div class="form-actions-row">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/equipment" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
