<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title>Notice | SmartConstruction</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container" style="max-width: 580px; text-align: center; margin-top: 3rem; margin-bottom: 4rem;">
        <div class="card" style="padding: 3rem 2rem; box-shadow: var(--shadow-lg);">
            <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
            <h1 style="color: var(--slate-900); font-size: 1.85rem; margin-bottom: 0.75rem;">System Notice</h1>
            <p style="font-size: 1.05rem; color: var(--slate-600); margin-bottom: 2rem; line-height: 1.6;"><%= message %></p>
            <div style="display: flex; gap: 0.75rem; justify-content: center;">
                <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
                <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
