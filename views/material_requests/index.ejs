<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 2rem;">
    <div class="header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2>🚨 Emergency Material Requests</h2>
            <p style="color: var(--text-muted);">Sprint 3 Feature &bull; Member D</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('requestModal').style.display='block'">+ New Request</button>
    </div>

    <!-- Modal for New Request -->
    <div id="requestModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div class="card" style="width: 92%; max-width: 500px; padding: 2rem; margin: 5% auto; position: relative; max-height: 90vh; overflow-y: auto;">
            <button onclick="document.getElementById('requestModal').style.display='none'" style="position: absolute; right: 1rem; top: 1rem; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.5rem;">&times;</button>
            <h3>Raise Material Request</h3>
            <form action="/material-requests" method="POST" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div class="form-group">
                    <label>Project</label>
                    <select name="project_id" class="form-control" required>
                        <% projects.forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Material</label>
                    <select name="material_id" class="form-control" required>
                        <% materials.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quantity Required</label>
                    <input type="number" step="0.01" name="quantity" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Priority</label>
                    <select name="priority" class="form-control" required>
                        <option value="Normal">Normal</option>
                        <option value="High">High</option>
                        <option value="Emergency" style="color: var(--accent-red); font-weight: bold;">Emergency (Work Halted!)</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Submit Request</button>
            </form>
        </div>
    </div>

    <div class="card" style="overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>PROJECT</th>
                    <th>MATERIAL</th>
                    <th>QTY</th>
                    <th>PRIORITY</th>
                    <th>STATUS</th>
                    <th>REQUESTED BY</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <% if (requests.length === 0) { %>
                    <tr><td colspan="8" style="text-align: center;">No material requests found.</td></tr>
                <% } else { %>
                    <% requests.forEach(r => { %>
                        <tr style="background: <%= r.priority === 'Emergency' ? 'rgba(255, 107, 107, 0.1)' : 'transparent' %>;">
                            <td>#<%= r.id %></td>
                            <td><%= r.project_name %></td>
                            <td><%= r.material_name %></td>
                            <td><%= r.quantity %></td>
                            <td>
                                <span class="badge badge-<%= r.priority === 'Emergency' ? 'emergency' : (r.priority === 'High' ? 'high' : 'normal') %>">
                                    <%= r.priority %>
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-<%= r.status === 'Pending' ? 'pending' : (r.status === 'Approved' ? 'approved' : (r.status === 'Rejected' ? 'emergency' : 'normal')) %>">
                                    <%= r.status %>
                                </span>
                            </td>
                            <td><%= r.requester_name %></td>
                            <td>
                                <% if (user.role === 'SuperAdmin' || user.role === 'Project Manager') { %>
                                    <% if (r.status === 'Pending') { %>
                                        <form action="/material-requests/<%= r.id %>/status" method="POST" style="display:inline;">
                                            <input type="hidden" name="status" value="Approved">
                                            <button type="submit" class="btn btn-primary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Approve</button>
                                        </form>
                                        <form action="/material-requests/<%= r.id %>/status" method="POST" style="display:inline;">
                                            <input type="hidden" name="status" value="Rejected">
                                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                        </form>
                                    <% } else if (r.status === 'Approved') { %>
                                        <form action="/material-requests/<%= r.id %>/status" method="POST" style="display:inline;">
                                            <input type="hidden" name="status" value="Fulfilled">
                                            <button type="submit" class="btn btn-success btn-sm">Mark Fulfilled</button>
                                        </form>
                                    <% } else { %>
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">None</span>
                                    <% } %>
                                <% } else { %>
                                    <span style="color: var(--text-muted); font-size: 0.8rem;">View Only</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Close modal if clicked outside
    window.onclick = function(event) {
        if (event.target == document.getElementById('requestModal')) {
            document.getElementById('requestModal').style.display = "none";
        }
    }
</script>

<%- include('../partials/footer') %>
</body>
</html>
