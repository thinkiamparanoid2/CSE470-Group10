<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container" style="max-width: 500px;">
        <div class="card" style="margin-top: 2rem;">
            <h2 style="text-align: center; margin-bottom: 1.5rem; color: var(--accent-orange);">Account Registration</h2>
            
            <% if (error) { %>
                <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #f87171; color: #f87171; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; text-align: center;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" required placeholder="e.g. Engr. Tanvir Alam">
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required placeholder="user@company.bd">
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••">
                </div>
                <div class="form-group">
                    <label for="role">Select System Role (Member D: RBAC)</label>
                    <select id="role" name="role">
                        <option value="Site Engineer">Site Engineer</option>
                        <option value="Project Manager">Project Manager</option>
                        <option value="Vendor">Vendor / Supplier</option>
                        <option value="SuperAdmin">SuperAdmin</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="text" id="phone" name="phone" placeholder="+8801700000000">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Create Account</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
