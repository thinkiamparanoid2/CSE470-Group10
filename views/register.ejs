<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="auth-shell">
        <div class="auth-art">
            <img src="/images/auth-illustration.svg" alt="Engineering blueprint illustration">
        </div>
        <div class="auth-form-side">
            <h2 style="margin-bottom: 1.5rem; color: var(--accent-orange);">Account Registration</h2>

            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" required placeholder="e.g. Engr. Tanvir Alam">
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required placeholder="user@company.bd">
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••">
                </div>
                <div class="form-group">
                    <label for="role">Account Type</label>
                    <select id="role" name="role">
                        <option value="Site Engineer">Site Engineer</option>
                        <option value="Vendor">Vendor / Supplier</option>
                    </select>
                    <small style="color: var(--text-muted); display: block; margin-top: 0.4rem;">
                        SuperAdmin and Project Manager accounts are provisioned internally by a SuperAdmin.
                    </small>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="text" id="phone" name="phone" placeholder="+8801700000000">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Create Account</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
