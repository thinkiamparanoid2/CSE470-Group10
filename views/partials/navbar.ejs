<nav class="navbar">
    <a href="/" class="brand">
        <img src="/images/logo-mark.svg" alt="SmartConstruction" class="brand-logo">
        SmartConstruction
    </a>

    <% if (user) { %>
        <button type="button" class="nav-toggle-btn" onclick="document.getElementById('navLinks').classList.toggle('mobile-open')">☰ Menu</button>
    <% } %>

    <ul class="nav-links" id="navLinks">
        <li><a href="/" class="nav-link">Home</a></li>

        <% if (user) { %>
            <li><a href="/dashboard" class="nav-link">Dashboard</a></li>

            <% if (user.role !== 'Vendor') { %>
                <li class="nav-item">
                    <span class="nav-link dropdown-toggle">Materials</span>
                    <div class="dropdown-menu">
                        <a href="/materials">Stock Tracking</a>
                        <a href="/purchase_orders">Purchase Orders</a>
                        <a href="/inventory-transfers">Inventory Transfers</a>
                        <a href="/waste-logs">Waste Log</a>
                        <a href="/boq">BOQ Generator</a>
                        <a href="/material-requests">Emergency Requests</a>
                    </div>
                </li>

                <li class="nav-item">
                    <span class="nav-link dropdown-toggle">Projects</span>
                    <div class="dropdown-menu">
                        <a href="/projects">All Projects</a>
                        <a href="/milestones">Milestones</a>
                        <a href="/dashboard_projects">Progress Dashboard</a>
                        <a href="/labor">Labor Attendance</a>
                        <a href="/site-reports">Daily Site Reports</a>
                        <a href="/expenses">Expense Reports</a>
                    </div>
                </li>
            <% } %>

            <li class="nav-item">
                <span class="nav-link dropdown-toggle">Vendors &amp; Finance</span>
                <div class="dropdown-menu">
                    <% if (user.role !== 'Vendor') { %>
                        <a href="/vendors">Vendor Directory</a>
                        <a href="/price-comparison">Price Comparison</a>
                    <% } %>
                    <a href="/payments">Payment Tracker</a>
                    <a href="/contracts">Contracts</a>
                    <a href="/deliveries">Deliveries</a>
                </div>
            </li>

            <li class="nav-item">
                <span class="nav-link dropdown-toggle">Admin</span>
                <div class="dropdown-menu">
                    <% if (user.role !== 'Vendor') { %>
                        <a href="/equipment">Equipment Scheduler</a>
                    <% } %>
                    <a href="/notices/board">Notice Board</a>
                    <% if (user.role === 'SuperAdmin' || user.role === 'Project Manager') { %>
                        <a href="/notices">Notice CMS</a>
                    <% } %>
                </div>
            </li>

            <li><span class="user-badge"><%= user.name %> (<%= user.role %>)</span></li>
            <li><a href="/logout" class="btn btn-secondary btn-sm">Logout</a></li>
        <% } else { %>
            <li><a href="/login" class="nav-link">Login</a></li>
            <li><a href="/register" class="btn btn-primary btn-sm">Register</a></li>
        <% } %>
    </ul>
</nav>

<% if (user) { %>
<script>
    // Touch-friendly dropdown toggling (desktop still opens on hover via CSS).
    document.querySelectorAll('.nav-item > .dropdown-toggle').forEach(function (toggle) {
        toggle.addEventListener('click', function (e) {
            var item = toggle.closest('.nav-item');
            var wasOpen = item.classList.contains('open');
            document.querySelectorAll('.nav-item.open').forEach(function (openItem) {
                if (openItem !== item) openItem.classList.remove('open');
            });
            item.classList.toggle('open', !wasOpen);
        });
    });
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.nav-item')) {
            document.querySelectorAll('.nav-item.open').forEach(function (openItem) {
                openItem.classList.remove('open');
            });
        }
    });
</script>
<% } %>
