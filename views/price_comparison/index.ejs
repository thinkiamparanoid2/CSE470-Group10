<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 2rem;">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><img src="/images/icon-price-comparison.svg" alt="" class="page-header-icon">Price Comparison Engine</h1>
            <p class="page-header-subtitle">Multi-vendor bidding analysis to find the best material rate.</p>
        </div>
    </div>

    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
        <form action="/price-comparison" method="GET" style="display: flex; gap: 1rem; align-items: flex-end;">
            <div class="form-group" style="flex: 1; margin: 0;">
                <label for="material_id">Select Material to Compare</label>
                <select name="material_id" id="material_id" class="form-control" required>
                    <option value="" disabled <%= !selectedMaterial ? 'selected' : '' %>>-- Select Material --</option>
                    <% materials.forEach(m => { %>
                        <option value="<%= m.id %>" <%= selectedMaterial && selectedMaterial.id == m.id ? 'selected' : '' %>>
                            <%= m.name %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Compare Prices</button>
        </form>
    </div>

    <% if (selectedMaterial) { %>
        <div class="card" style="padding: 2rem;">
            <h3 style="margin-top: 0;">Quotations for <%= selectedMaterial.name %></h3>
            
            <% if (quotations.length === 0) { %>
                <p>No vendor quotations found for this material.</p>
            <% } else { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
                    <% quotations.forEach((q, index) => { %>
                        <div style="background: rgba(20, 87, 153, 0.06); padding: 1.5rem; border-radius: 12px; border: 1px solid <%= index === 0 ? 'var(--primary-color)' : 'rgba(20, 87, 153, 0.08)' %>; position: relative;">
                            <% if (index === 0) { %>
                                <div style="position: absolute; top: -10px; right: -10px; background: var(--primary-color); color: white; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.75rem; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                                    BEST PRICE
                                </div>
                            <% } %>
                            
                            <h4 style="margin: 0 0 0.5rem 0; color: var(--text-primary);"><%= q.company_name %></h4>
                            <div style="font-size: 1.5rem; font-weight: bold; color: var(--primary-color); margin-bottom: 1rem;">
                                <%= q.price %> ৳ <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: normal;">/ unit</span>
                            </div>
                            
                            <div style="font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
                                <span>⭐ <%= q.rating %> / 5.00</span>
                                <span>📞 <%= q.phone %></span>
                                <span>🕒 Updated: <%= new Date(q.last_updated).toLocaleDateString() %></span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
</body>
</html>
