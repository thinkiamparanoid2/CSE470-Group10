<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .print-only {
            display: none;
        }
        @media print {
            .navbar, .no-print, .btn, footer {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .print-header-box {
                border-bottom: 2px solid #000;
                padding-bottom: 15px;
                margin-bottom: 20px;
            }
            .print-meta-table {
                width: 100% !important;
                margin-bottom: 25px !important;
                border: none !important;
            }
            .print-meta-table td {
                border: none !important;
                padding: 5px 0 !important;
                font-size: 11pt !important;
            }
            .signature-section {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-between !important;
                margin-top: 65px !important;
                page-break-inside: avoid;
            }
            .signature-block {
                width: 250px;
                text-align: center;
                border-top: 1px solid #000 !important;
                padding-top: 8px;
                font-size: 10pt;
            }
            .grid-2 > div, .card {
                border: 1px solid #333 !important;
                background: transparent !important;
                margin-bottom: 20px !important;
                padding: 15px !important;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <%
        const headcount = (typeof totalHeadcount !== 'undefined') ? parseInt(totalHeadcount || 0) : ((typeof aggregated !== 'undefined' && aggregated) ? parseInt(aggregated.labor_headcount || 0) : 0);
        const payroll = (typeof totalLaborCost !== 'undefined') ? parseFloat(totalLaborCost || 0) : ((typeof aggregated !== 'undefined' && aggregated) ? parseFloat(aggregated.labor_cost || 0) : 0);
        const deliveriesCount = (typeof emergencyRequests !== 'undefined' && emergencyRequests) ? emergencyRequests.length : ((typeof aggregated !== 'undefined' && aggregated) ? parseInt(aggregated.deliveries_today || 0) : 0);
        const wasteCount = (typeof wasteLogs !== 'undefined' && wasteLogs) ? wasteLogs.length : 0;
    %>

    <div class="container">
        <!-- Professional Corporate Print Letterhead -->
        <div class="print-only print-header-box">
            <h2 style="margin: 0; font-size: 18pt; text-transform: uppercase; letter-spacing: 0.5px;">Smarstruction Engineering & Infrastructure Ltd.</h2>
            <h3 style="margin: 5px 0 0 0; font-size: 13pt; color: #333; font-weight: 600;">Official Daily Construction Site Inspection & Progress Report</h3>
        </div>

        <div class="print-only">
            <table class="print-meta-table">
                <tr>
                    <td style="width: 18%;"><strong>Project Site Name:</strong></td>
                    <td style="width: 42%;"><%= report.project_name %></td>
                    <td style="width: 18%;"><strong>Report Reference:</strong></td>
                    <td style="width: 22%;">#DSR-<%= report.id %>-2026</td>
                </tr>
                <tr>
                    <td><strong>Inspection Date:</strong></td>
                    <td><strong><%= new Date(report.report_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong></td>
                    <td><strong>Weather & Temp:</strong></td>
                    <td><%= report.weather_condition %></td>
                </tr>
                <tr>
                    <td><strong>Filed By (Engineer):</strong></td>
                    <td><%= report.engineer_name || 'Assigned Site Engineer' %></td>
                    <td><strong>Report Status:</strong></td>
                    <td>VERIFIED & PUBLISHED</td>
                </tr>
            </table>
        </div>

        <!-- Web UI Header -->
        <div class="page-header no-print">
            <div>
                <h2>Daily Site Report: <%= report.project_name %></h2>
                <p style="color: var(--text-muted);">Date: <strong><%= new Date(report.report_date).toLocaleDateString('en-GB', { dateStyle: 'full' }) %></strong> | Engineer: <%= report.engineer_name || 'N/A' %></p>
            </div>
            <div>
                <button onclick="window.print()" class="btn btn-primary">🖨️ Print / Save Official PDF</button>
                <a href="/site-reports" class="btn btn-secondary">&larr; Back to Reports</a>
            </div>
        </div>

        <!-- Weather & Basic Specs Badge -->
        <div class="card no-print" style="margin-bottom: 1.5rem; background: rgba(255, 255, 255, 0.03);">
            <div style="display: flex; gap: 3rem;">
                <div>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Weather Conditions:</span>
                    <h3 style="color: var(--accent-amber); margin-top: 0.2rem;"><%= report.weather_condition %></h3>
                </div>
                <div>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Report Filed Date:</span>
                    <h3 style="margin-top: 0.2rem;"><%= new Date(report.report_date).toLocaleDateString('en-GB') %></h3>
                </div>
            </div>
        </div>

        <div class="grid-2">
            <!-- Left: Qualitative Engineering & Safety Notes -->
            <div class="card">
                <h3 style="margin-bottom: 1rem; color: var(--text-main);">📋 Structural Progress & Engineering Log</h3>
                <div style="margin-bottom: 1.5rem;">
                    <strong style="color: var(--accent-blue);">General Site Work Completed Today:</strong>
                    <p style="margin-top: 0.5rem; line-height: 1.6; white-space: pre-line; color: var(--text-light);"><%= report.general_progress || 'No general progress remarks entered.' %></p>
                </div>

                <div>
                    <strong style="color: var(--accent-red);">🛡️ OH&S Safety Audits & Incidents:</strong>
                    <p style="margin-top: 0.5rem; line-height: 1.6; white-space: pre-line; color: var(--text-light);"><%= report.safety_incidents || 'Zero safety incidents reported today.' %></p>
                </div>
            </div>

            <!-- Right: System Auto-Aggregated Metrics -->
            <div class="card">
                <h3 style="margin-bottom: 1rem; color: var(--text-main);">⚙️ System Auto-Aggregated Metrics (Today)</h3>

                <div style="margin-bottom: 1.2rem; padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 6px; border-left: 4px solid var(--accent-green);">
                    <p style="color: var(--text-muted); font-size: 0.85rem;">👷 Workforce Labor & Payroll Recorded Today:</p>
                    <h4 style="font-size: 1.2rem; margin-top: 0.3rem;">
                        <%= (headcount > 0) ? headcount + ' Workers on Site' : '0 Workers Logged Today' %>
                    </h4>
                    <% if (payroll > 0) { %>
                        <p style="color: var(--accent-green); font-size: 0.95rem; margin-top: 0.2rem;">Daily Labor Payroll: <strong>৳<%= payroll.toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong></p>
                    <% } %>
                </div>

                <div style="margin-bottom: 1.2rem; padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 6px; border-left: 4px solid var(--accent-orange);">
                    <p style="color: var(--text-muted); font-size: 0.85rem;">📦 Material Shipments & Emergency Requests:</p>
                    <h4 style="font-size: 1.2rem; margin-top: 0.3rem;">
                        <%= (deliveriesCount > 0) ? deliveriesCount + ' Material Consignments' : 'No Incoming Shipments Logged Today' %>
                    </h4>
                    <small style="color: var(--text-muted); display: block; margin-top: 0.3rem;">Verified against site inventory and logistics tables.</small>
                </div>

                <div style="padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 6px; border-left: 4px solid var(--accent-blue);">
                    <p style="color: var(--text-muted); font-size: 0.85rem;">🗑️ Material Wastage Auditing:</p>
                    <h4 style="font-size: 1.2rem; margin-top: 0.3rem;">
                        <%= (wasteCount > 0) ? wasteCount + ' Waste Records Logged Today' : '0 Waste Logged (100% Efficiency)' %>
                    </h4>
                </div>
            </div>
        </div>

        <!-- Corporate Signature Block (Only in PDF printout) -->
        <div class="print-only signature-section">
            <div class="signature-block">
                <strong>Recorded By (Site Field Engineer)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
            <div class="signature-block">
                <strong>Reviewed By (Safety & OH&S Officer)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
            <div class="signature-block">
                <strong>Approved By (Project Manager)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
        </div>
        <div class="print-only" style="margin-top: 35px; font-size: 8.5pt; color: #666; border-top: 1px solid #ddd; padding-top: 8px;">
            <em>Notice: This Daily Site Report is an official engineering legal record of site conditions, work achievement, and safety verification under Smarstruction QA guidelines.</em>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
