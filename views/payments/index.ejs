<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h2>💳 Vendor Payment Tracker</h2>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Sprint 4 Feature • Member B (Vendors & Financials)</p>
            </div>
            <% if (user && user.role !== 'Vendor') { %>
                <a href="/payments/create" class="btn btn-primary">+ Record Payment Disbursement</a>
            <% } %>
        </div>

        <!-- Vendor Financial Account Balances Table -->
        <div class="card">
            <h3>Supplier Financial Overview & Account Ledger</h3>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Vendor / Company</th>
                            <th>Contact Person</th>
                            <th>Category</th>
                            <th>Total PO Value</th>
                            <th>Total Paid</th>
                            <th>Outstanding Balance</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendors && vendors.length > 0) { %>
                            <% vendors.forEach(v => { 
                                 const bal = parseFloat(v.outstanding_balance);
                            %>
                                <tr>
                                    <td><strong><%= v.company_name %></strong></td>
                                    <td><%= v.contact_person || 'N/A' %> (<%= v.phone %>)</td>
                                    <td><%= v.material_category %></td>
                                    <td>৳<%= parseFloat(v.total_billed).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                    <td style="color: var(--accent-green); font-weight: bold;">
                                        ৳<%= parseFloat(v.total_paid).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                    </td>
                                    <td style="font-weight: bold; color: <%= bal > 0 ? 'var(--accent-red)' : 'var(--text-light)' %>;">
                                        ৳<%= bal.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= bal <= 0 ? 'status-good' : 'status-lowstock' %>">
                                            <%= bal <= 0 ? 'Settled / Advance' : 'Due Balance' %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/payments/vendor/<%= v.id %>" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">Ledger Statement &rarr;</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                    No vendors or payment profiles recorded yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Transactions Log -->
        <div class="card" style="margin-top: 1.5rem;">
            <h3>🔄 Recent Payment Disbursements & Receipts</h3>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Vendor Beneficiary</th>
                            <th>Payment Type</th>
                            <th>Method & Reference</th>
                            <th>Amount (৳)</th>
                            <th>Recorded By</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentPayments && recentPayments.length > 0) { %>
                            <% recentPayments.forEach(tx => { %>
                                <tr>
                                    <td><%= new Date(tx.payment_date).toLocaleDateString() %></td>
                                    <td><strong><%= tx.vendor_name %></strong></td>
                                    <td>
                                        <span class="status-badge status-good" style="font-size: 0.8rem;"><%= tx.payment_type %></span>
                                    </td>
                                    <td><%= tx.payment_method %> <br><small style="color: var(--text-muted);"><%= tx.reference_no || '' %></small></td>
                                    <td style="font-weight: bold; color: var(--accent-green); font-size: 1.05rem;">
                                        ৳<%= parseFloat(tx.amount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                    </td>
                                    <td><%= tx.recorder_name || 'Admin' %></td>
                                    <td style="max-width: 250px; font-size: 0.9rem;"><%= tx.notes || 'No comments' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                    No payment transactions disbursed yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
