<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 780px;">
        <div class="card" style="margin-top: 2rem;">
            <h2 class="page-header-title" style="margin-bottom: 0.35rem;"><img src="/images/icon-labor.svg" alt="" class="page-header-icon" style="width: 30px; height: 30px;">Log Daily Labor</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Record on-site headcount and wage cost for a project day.</p>

            <form action="/labor/create" method="POST">
                <div class="grid-2">
                    <div class="form-group">
                        <label>Project</label>
                        <select name="project_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Log Date</label>
                        <input type="date" name="log_date" required style="width: 100%; padding: 0.5rem;">
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Total Headcount</label>
                        <input type="number" name="headcount" min="1" required placeholder="e.g. 15" style="width: 100%; padding: 0.5rem;">
                    </div>
                    <div class="form-group">
                        <label>Total Labor Cost (৳)</label>
                        <input type="number" step="0.01" name="total_cost" required placeholder="e.g. 15000" style="width: 100%; padding: 0.5rem;">
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label>Notes (Optional)</label>
                    <textarea name="notes" rows="3" placeholder="Any special incidents, weather conditions, etc." style="width: 100%; padding: 0.5rem;"></textarea>
                </div>

                <div class="form-actions-row">
                    <button type="submit" class="btn btn-primary">Submit Log</button>
                    <a href="/labor" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
