<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-labor.svg" alt="" class="page-header-icon">Labor Attendance &amp; Cost Log</h1>
                <p class="page-header-subtitle">Daily on-site headcounts and wage cost records per project.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager' || user.role === 'Site Engineer')) { %>
                <div class="header-actions">
                    <a href="/labor/create" class="btn btn-primary">+ Log Labor</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Project</th>
                            <th>Headcount</th>
                            <th>Total Cost</th>
                            <th>Logged By</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (laborLogs && laborLogs.length > 0) { %>
                            <% laborLogs.forEach(log => { %>
                                <tr>
                                    <td><%= new Date(log.log_date).toLocaleDateString() %></td>
                                    <td><%= log.project_name %></td>
                                    <td><%= log.headcount %> workers</td>
                                    <td>৳<%= parseFloat(log.total_cost).toLocaleString() %></td>
                                    <td><%= log.created_by_name %></td>
                                    <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= log.notes %>">
                                        <%= log.notes || '-' %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No labor logs found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
