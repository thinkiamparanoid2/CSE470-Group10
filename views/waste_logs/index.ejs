<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 2rem;">
    <div class="header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2>🗑️ Material Waste Log</h2>
            <p style="color: var(--text-muted);">Sprint 3 Feature &bull; Member A</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('wasteModal').style.display='block'">+ Log Waste</button>
    </div>

    <!-- Modal for Logging Waste -->
    <div id="wasteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div class="card" style="width: 500px; padding: 2rem; margin: 5% auto; position: relative; max-height: 90vh; overflow-y: auto;">
            <button onclick="document.getElementById('wasteModal').style.display='none'" style="position: absolute; right: 1rem; top: 1rem; background: none; border: none; color: white; cursor: pointer; font-size: 1.5rem;">&times;</button>
            <h3>Log Material Waste</h3>
            <form action="/waste-logs" method="POST" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div class="form-group">
                    <label>Project</label>
                    <select name="project_id" class="form-control" required>
                        <% projects.forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Material</label>
                    <select name="material_id" class="form-control" required>
                        <% materials.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group" style="display: flex; gap: 1rem;">
                    <div style="flex: 1;">
                        <label>Wasted Quantity</label>
                        <input type="number" step="0.01" name="waste_quantity" class="form-control" required>
                    </div>
                    <div style="flex: 1;">
                        <label>Date</label>
                        <input type="date" name="log_date" class="form-control" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>Reason (e.g., Weather Damage, Mishandling)</label>
                    <input type="text" name="reason" class="form-control" placeholder="Brief reason for waste..." required>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Submit Log</button>
            </form>
        </div>
    </div>

    <div class="card" style="overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>DATE</th>
                    <th>PROJECT</th>
                    <th>MATERIAL</th>
                    <th>WASTED QTY</th>
                    <th>REASON</th>
                    <th>LOGGED BY</th>
                </tr>
            </thead>
            <tbody>
                <% if (logs.length === 0) { %>
                    <tr><td colspan="7" style="text-align: center;">No waste logs found. Good job!</td></tr>
                <% } else { %>
                    <% logs.forEach(log => { %>
                        <tr>
                            <td>#<%= log.id %></td>
                            <td><%= new Date(log.log_date).toLocaleDateString() %></td>
                            <td><%= log.project_name %></td>
                            <td><%= log.material_name %></td>
                            <td style="color: #ff6b6b; font-weight: bold;"><%= log.waste_quantity %></td>
                            <td><%= log.reason %></td>
                            <td><%= log.logger_name %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Close modal if clicked outside
    window.onclick = function(event) {
        if (event.target == document.getElementById('wasteModal')) {
            document.getElementById('wasteModal').style.display = "none";
        }
    }
</script>

<%- include('../partials/footer') %>
</body>
</html>
