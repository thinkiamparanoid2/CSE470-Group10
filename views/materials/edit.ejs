<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 550px;">
        <div class="card" style="margin-top: 2rem;">
            <div class="page-header">
                <h2>Edit Material Item</h2>
                <a href="/materials" class="btn btn-secondary" style="padding: 0.35rem 0.75rem;">Back</a>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #f87171; color: #f87171; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; text-align: center;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/materials/edit/<%= material.id %>" method="POST">
                <div class="form-group">
                    <label for="name">Material Name</label>
                    <input type="text" id="name" name="name" required value="<%= material.name %>">
                </div>
                <div class="form-group">
                    <label for="category">Category</label>
                    <input type="text" id="category" name="category" value="<%= material.category %>">
                </div>
                <div class="form-group">
                    <label for="unit">Measurement Unit</label>
                    <input type="text" id="unit" name="unit" required value="<%= material.unit %>">
                </div>
                <div class="form-group">
                    <label for="current_stock">Current Stock Quantity</label>
                    <input type="number" step="0.01" id="current_stock" name="current_stock" required value="<%= material.current_stock %>">
                </div>
                <div class="form-group">
                    <label for="reorder_level">Reorder Level Alert Threshold</label>
                    <input type="number" step="0.01" id="reorder_level" name="reorder_level" required value="<%= material.reorder_level %>">
                </div>
                <div class="form-group">
                    <label for="unit_price_est">Estimated Unit Price (BDT)</label>
                    <input type="number" step="0.01" id="unit_price_est" name="unit_price_est" value="<%= material.unit_price_est %>">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Update Material Record</button>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
