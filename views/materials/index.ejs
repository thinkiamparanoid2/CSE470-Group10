<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-materials.svg" alt="" class="page-header-icon">Material Stock Tracking</h1>
                <p class="page-header-subtitle">Live inventory levels, reorder alerts, and unit cost tracking across every active site.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                <div class="header-actions">
                    <a href="/materials/create" class="btn btn-primary">+ Add New Material</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Material Name</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Reorder Threshold</th>
                            <th>Est. Unit Price</th>
                            <th>Stock Status</th>
                            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                <th>Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (materials && materials.length > 0) { %>
                            <% materials.forEach(m => { %>
                                <tr>
                                    <td><strong><%= m.name %></strong></td>
                                    <td><%= m.category %></td>
                                    <td><%= m.current_stock %> <%= m.unit %></td>
                                    <td><%= m.reorder_level %> <%= m.unit %></td>
                                    <td>৳<%= Number(m.unit_price_est).toLocaleString() %></td>
                                    <td>
                                        <span class="status-badge <%= Number(m.current_stock) <= Number(m.reorder_level) ? 'status-lowstock' : 'status-good' %>">
                                            <%= Number(m.current_stock) <= Number(m.reorder_level) ? 'Low Stock Warning' : 'In Stock' %>
                                        </span>
                                    </td>
                                    <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                        <td>
                                            <div style="display: flex; gap: 0.4rem;">
                                                <a href="/materials/edit/<%= m.id %>" class="btn btn-secondary btn-xs">Edit</a>
                                                <form action="/materials/delete/<%= m.id %>" method="POST">
                                                    <button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('Delete this material?');">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No materials logged in stock yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
