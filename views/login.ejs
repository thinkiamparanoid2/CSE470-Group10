<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="auth-split-wrapper">
        <div class="auth-split-card">
            <!-- Left Brand Showcase -->
            <div class="auth-brand-side">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 2rem;">
                        <img src="/images/logo-mark.svg" alt="SmartConstruction Logo" style="width: 38px; height: 38px; border-radius: 9px; box-shadow: 0 4px 12px rgba(37,99,235,0.4);">
                        <span style="font-family: 'Space Grotesk', 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF;">SmartConstruction</span>
                    </div>
                    <h2 style="color: #FFFFFF; font-size: 2rem; line-height: 1.25; margin-bottom: 1rem;">
                        The Operating System for Enterprise Infrastructure.
                    </h2>
                    <p style="color: #BFDBFE; font-size: 0.98rem; line-height: 1.6;">
                        Secure role-based access for Project Managers, Site Engineers, Suppliers, and Executives.
                    </p>
                </div>

                <div>
                    <img src="/images/auth-illustration.svg" alt="Architecture Blueprint" style="width: 100%; height: auto; display: block; margin: 1.5rem 0; opacity: 0.95; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.25);">
                    <div class="auth-brand-quote">
                        "Precision in material procurement and real-time site logging across all projects."
                    </div>
                </div>
            </div>

            <!-- Right Form Panel -->
            <div class="auth-form-side">
                <div style="margin-bottom: 1.75rem;">
                    <span style="font-size: 0.78rem; font-weight: 700; color: var(--primary-600); text-transform: uppercase; letter-spacing: 0.05em;">Welcome Back</span>
                    <h2 style="font-size: 1.85rem; color: var(--slate-900); margin-top: 0.25rem;">Sign in to Workspace</h2>
                    <p style="color: var(--slate-500); font-size: 0.9rem; margin-top: 0.25rem;">Enter your verified credentials to continue</p>
                </div>

                <% if (error) { %>
                    <div class="alert alert-error">
                        <span>⚠️</span>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="email">Work Email</label>
                        <input type="email" id="email" name="email" required placeholder="e.g. admin@smartconstruction.bd">
                    </div>
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
                            <label for="password" style="margin-bottom: 0;">Password</label>
                        </div>
                        <input type="password" id="password" name="password" required placeholder="••••••••">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block" style="margin-top: 0.75rem;">
                        Sign In &rarr;
                    </button>
                </form>

                <div style="margin-top: 1.5rem; text-align: center; font-size: 0.88rem; color: var(--slate-500);">
                    New contractor or engineer? <a href="/register" style="font-weight: 600; color: var(--primary-600);">Register an Account</a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
