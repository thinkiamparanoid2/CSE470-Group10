<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container" style="max-width: 450px;">
        <div class="card" style="margin-top: 3rem;">
            <h2 style="text-align: center; margin-bottom: 1.5rem; color: var(--accent-orange);">Portal Login</h2>
            
            <% if (error) { %>
                <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #f87171; color: #f87171; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; text-align: center;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required placeholder="e.g. pm@smarstruction.bd">
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Sign In</button>
            </form>

            <div style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted); background: rgba(15,23,42,0.8); padding: 0.8rem; border-radius: 8px;">
                <strong>Test Accounts (Seed Data):</strong><br>
                • <code>admin@smarstruction.bd</code> (SuperAdmin)<br>
                • <code>pm@smarstruction.bd</code> (Project Manager)<br>
                • <code>engineer@smarstruction.bd</code> (Site Engineer)<br>
                <em>Default password for demo: <code>admin123</code></em>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
