<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <!-- Hero Section -->
        <div class="card hero" style="padding: 3rem 2.5rem; background: linear-gradient(135deg, rgba(30,41,59,0.95), rgba(15,23,42,0.95)); border: 1px solid rgba(30,41,59,0.4);">
            <div class="hero-copy">
                <h1 style="font-size: 2.6rem; margin-bottom: 1rem; color: #fff; line-height: 1.15;">Smart Construction Management in Bangladesh</h1>
                <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 520px; margin: 0 0 2rem;">
                    Streamlining building material stock, vendor procurement, labor allocation, and site reports across ongoing construction projects.
                </p>
                <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                    <a href="/login" class="btn btn-primary">Access Platform Dashboard</a>
                    <a href="#projects" class="btn btn-secondary">Explore Firm Portfolio</a>
                </div>
            </div>
            <div class="hero-art">
                <img src="/images/hero-illustration.svg" alt="Construction site illustration">
            </div>
        </div>

        <!-- Trust / Stats Strip -->
        <div class="stats-strip">
            <div>
                <div class="stat-number"><%= siteCount %></div>
                <div class="stat-label">Active Construction Sites</div>
            </div>
            <div>
                <div class="stat-number"><%= vendorCount %></div>
                <div class="stat-label">Verified Material Vendors</div>
            </div>
            <div>
                <div class="stat-number"><%= materialCount %></div>
                <div class="stat-label">Material Categories Tracked</div>
            </div>
            <div>
                <div class="stat-number">4</div>
                <div class="stat-label">Role-Based Access Levels</div>
            </div>
        </div>

        <!-- Platform Capabilities -->
        <div class="section-intro">
            <h2>Everything a Site Office Needs, in One Platform</h2>
            <p>From procurement to payroll, SmartConstruction replaces scattered spreadsheets and phone calls with one connected system built for construction firms operating across multiple sites.</p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <img src="/images/feature-inventory.svg" alt="">
                <span class="feature-tag">Materials</span>
                <h3>Stock &amp; Procurement Control</h3>
                <p>Real-time material stock, purchase orders, and inter-site inventory transfers so a site never runs short — or over-orders.</p>
            </div>
            <div class="feature-card">
                <img src="/images/vendor-building.svg" alt="">
                <span class="feature-tag">Vendors</span>
                <h3>Supplier &amp; Vendor Network</h3>
                <p>Compare quotations, manage contracts, and track every disbursement against a rated directory of verified suppliers.</p>
            </div>
            <div class="feature-card">
                <img src="/images/feature-tracking.svg" alt="">
                <span class="feature-tag">Projects</span>
                <h3>Progress &amp; Labor Tracking</h3>
                <p>Gantt-lite progress dashboards, daily site reports, and labor attendance logs kept current for every active site.</p>
            </div>
            <div class="feature-card">
                <img src="/images/feature-reports.svg" alt="">
                <span class="feature-tag">Finance</span>
                <h3>Reporting &amp; Compliance</h3>
                <p>Exportable Bills of Quantities, expense reports, and vendor ledgers ready for audits, or handover to a client.</p>
            </div>
        </div>

        <!-- Featured Projects CMS (Member D) -->
        <h2 id="projects" style="margin-bottom: 1rem; color: var(--accent-amber);">🏢 Featured Active Construction Sites</h2>
        <div class="grid-2">
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(p => { %>
                    <%
                        let coverImg = '/images/project-cover.svg';
                        const pname = (p.name || '').toLowerCase();
                        if (pname.includes('dhanmondi')) coverImg = '/images/project-dhanmondi.jpg';
                        else if (pname.includes('uttara')) coverImg = '/images/project-uttara.jpg';
                    %>
                    <div class="card">
                        <img src="<%= coverImg %>" alt="<%= p.name %> site photo" class="project-cover">
                        <h3><%= p.name %></h3>
                        <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.2rem;">📍 <%= p.location %></p>
                        <hr style="border-color: var(--border-color); margin: 0.8rem 0;">
                        <p><strong>Budget:</strong> ৳<%= Number(p.budget).toLocaleString() %> BDT</p>
                        <p><strong>Status:</strong> <span class="status-badge status-ongoing"><%= p.status %></span></p>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card"><p>No public portfolio projects listed yet.</p></div>
            <% } %>
        </div>

        <!-- Public Notice Board CMS (Member D) -->
        <h2 style="margin: 2rem 0 1rem; color: var(--accent-blue);">📢 Company Announcements & Site Bulletins</h2>
        <div class="card">
            <% if (notices && notices.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Priority</th>
                                <th>Notice Title</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% notices.forEach(n => { %>
                                <tr>
                                    <td><%= new Date(n.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge <%= n.priority === 'Emergency' ? 'status-lowstock' : (n.priority === 'High' ? 'status-moderate' : 'status-good') %>">
                                            <%= n.priority %>
                                        </span>
                                    </td>
                                    <td><strong><%= n.title %></strong></td>
                                    <td><%= n.content %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p style="color: var(--text-muted);">No urgent notices posted today.</p>
            <% } %>
        </div>

        <!-- Closing CTA -->
        <div class="cta-banner">
            <h2>Ready to bring your next site on-platform?</h2>
            <p>Sign in with your team credentials, or register as a Site Engineer or Vendor to get started.</p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="/login" class="btn btn-primary">Sign In</a>
                <a href="/register" class="btn btn-secondary">Create an Account</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
