<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .enterprise-hero {
            background:
                linear-gradient(135deg, #0C2140 0%, #164080 50%, #0F172A 100%);
            border-radius: var(--radius-xl);
            padding: 4rem 3.5rem;
            color: #FFFFFF;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: var(--shadow-xl);
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
            gap: 2.5rem;
            align-items: center;
            margin-bottom: 2.5rem;
        }
        .enterprise-hero > * {
            min-width: 0;
            position: relative;
        }
        /* Faint blueprint grid — a quiet nod to construction drafting, felt more
           than seen, sitting under the glow layers so it never competes with them. */
        .enterprise-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: radial-gradient(ellipse 90% 90% at 30% 40%, #000 40%, transparent 85%);
            pointer-events: none;
        }
        .enterprise-hero::after {
            content: '';
            position: absolute;
            top: -120px;
            right: -120px;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.35) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero-glow-accent {
            position: absolute;
            bottom: -140px;
            left: -80px;
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, var(--brand-orange-glow) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero-headline {
            font-family: 'Space Grotesk', 'Outfit', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: #FFFFFF;
            margin-bottom: 1.25rem;
        }
        .hero-headline span {
            background: linear-gradient(120deg, #93C5FD, #60A5FA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-subtitle {
            font-size: 1.1rem;
            color: #CBD5E1;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            max-width: 580px;
        }
        .hero-checklist {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1.5rem;
            margin-bottom: 2rem;
        }
        .hero-checklist span {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.88rem;
            font-weight: 600;
            color: #E2E8F0;
        }
        .hero-checklist span::before {
            content: '✓';
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--brand-orange);
            color: #FFFFFF;
            font-size: 0.68rem;
            font-weight: 800;
            flex-shrink: 0;
        }
        .hero-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .hero-art-box {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }
        .hero-art-box img {
            max-height: 340px;
            filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.35));
        }

        /* Stats Ribbon */
        .stats-ribbon {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-top: none;
            border-radius: var(--radius-lg);
            padding: 2rem 2.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 3.5rem;
            position: relative;
        }
        .stats-ribbon::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            background: linear-gradient(90deg, var(--primary-600) 0%, var(--brand-orange) 100%);
        }
        .ribbon-item {
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border-light);
            padding-right: 1.5rem;
        }
        .ribbon-item:last-child {
            border-right: none;
            padding-right: 0;
        }
        .ribbon-value {
            font-family: 'Outfit', sans-serif;
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--primary-700);
            line-height: 1;
            margin-bottom: 0.35rem;
        }
        .ribbon-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--slate-500);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        /* Feature Cards */
        .features-section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 2.5rem;
        }
        .features-section-header h2 {
            font-family: 'Space Grotesk', 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 2.2rem;
            color: var(--slate-900);
            margin-bottom: 0.75rem;
        }
        .features-section-header p {
            font-size: 1.05rem;
            color: var(--slate-600);
        }

        .feature-grid-corporate {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
            gap: 1.5rem;
            margin-bottom: 3.5rem;
        }
        .feature-card-corporate {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 2rem;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-fast);
            position: relative;
            overflow: hidden;
        }
        .feature-card-corporate::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-600), var(--brand-orange));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform var(--transition-fast);
        }
        .feature-card-corporate:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-300);
        }
        .feature-card-corporate:hover::before {
            transform: scaleX(1);
        }
        .feature-icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            background: var(--primary-50);
            border: 1px solid var(--primary-100);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
        }
        .feature-icon-wrapper img {
            width: 26px;
            height: 26px;
        }
        .feature-pill-tag {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--primary-600);
            margin-bottom: 0.5rem;
        }
        .feature-card-corporate h3 {
            font-size: 1.2rem;
            color: var(--slate-900);
            margin-bottom: 0.65rem;
        }
        .feature-card-corporate p {
            font-size: 0.92rem;
            color: var(--slate-600);
            line-height: 1.55;
        }

        /* Portfolio Project Cards */
        .projects-portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
            gap: 1.5rem;
            margin-bottom: 3.5rem;
            align-items: stretch;
        }
        .project-corporate-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-fast);
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .project-corporate-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: var(--slate-300);
        }
        .project-image-banner {
            height: 220px;
            width: 100%;
            object-fit: cover;
            border-bottom: 1px solid var(--border-color);
            display: block;
            background: var(--slate-100);
        }
        .project-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .project-title-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.75rem;
            min-height: 3.6rem;
            margin-bottom: 0.35rem;
        }
        .project-title-row h3 {
            font-size: 1.25rem;
            line-height: 1.35;
            margin: 0;
            font-weight: 700;
            color: var(--slate-900);
        }
        .project-location {
            color: var(--slate-500);
            font-size: 0.88rem;
            margin-bottom: 1.25rem;
            min-height: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }
        .project-footer-row {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid var(--border-light);
        }

        .cta-enterprise {
            background: linear-gradient(135deg, var(--slate-900) 0%, var(--primary-900) 100%);
            border-radius: var(--radius-xl);
            padding: 3.5rem 2rem;
            text-align: center;
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: var(--shadow-xl);
            margin: 3rem 0;
        }
        .cta-enterprise h2 {
            font-family: 'Space Grotesk', 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 2.2rem;
            color: #FFFFFF;
            margin-bottom: 0.75rem;
        }
        .cta-enterprise p {
            color: #CBD5E1;
            font-size: 1.05rem;
            max-width: 600px;
            margin: 0 auto 2rem;
        }

        @media (max-width: 1024px) {
            .enterprise-hero {
                grid-template-columns: 1fr;
                padding: 2.5rem 2rem;
            }
            .hero-art-box {
                display: none;
            }
            .stats-ribbon {
                grid-template-columns: 1fr 1fr;
                gap: 1.25rem;
            }
            .ribbon-item:nth-child(2) {
                border-right: none;
            }
        }
        @media (max-width: 640px) {
            .stats-ribbon {
                grid-template-columns: 1fr;
            }
            .ribbon-item {
                border-right: none;
                border-bottom: 1px solid var(--border-light);
                padding-bottom: 1rem;
                padding-right: 0;
            }
            .ribbon-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }
            .hero-headline {
                font-size: 2.2rem;
            }
            .hero-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .hero-actions .btn {
                white-space: normal;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <!-- Enterprise Hero Section -->
        <div class="enterprise-hero">
            <div class="hero-glow-accent"></div>
            <div>
                <h1 class="hero-headline">
                    Intelligent Construction Management <span>Across Bangladesh</span>
                </h1>
                <p class="hero-subtitle">
                    Streamlining material inventory, multi-vendor procurement, project Gantt milestones, and site compliance in one unified corporate platform.
                </p>
                <div class="hero-checklist">
                    <span>Real-time inventory</span>
                    <span>Multi-vendor bidding</span>
                    <span>Site compliance logs</span>
                </div>
                <div class="hero-actions">
                    <a href="/login" class="btn btn-brand btn-lg">Access Platform Dashboard</a>
                    <a href="#projects" class="btn btn-secondary btn-on-dark btn-lg">Explore Active Sites</a>
                </div>
            </div>
            <div class="hero-art-box">
                <img src="/images/hero-illustration.svg" alt="SmartConstruction Architectural Illustration">
            </div>
        </div>

        <!-- Real-time Statistics Ribbon -->
        <div class="stats-ribbon">
            <div class="ribbon-item">
                <div class="ribbon-value"><%= siteCount %></div>
                <div class="ribbon-label">Active Construction Sites</div>
            </div>
            <div class="ribbon-item">
                <div class="ribbon-value"><%= vendorCount %></div>
                <div class="ribbon-label">Verified Suppliers &amp; Vendors</div>
            </div>
            <div class="ribbon-item">
                <div class="ribbon-value"><%= materialCount %></div>
                <div class="ribbon-label">Materials &amp; BOQ Categories</div>
            </div>
            <div class="ribbon-item">
                <div class="ribbon-value" style="color: var(--brand-orange);">100%</div>
                <div class="ribbon-label">Platform Uptime &amp; Reliability</div>
            </div>
        </div>

        <!-- Corporate Features Showcase -->
        <div class="features-section-header">
            <span class="feature-pill-tag">Platform Capabilities</span>
            <h2>Everything It Takes to Run Your Site</h2>
            <p>Purpose-built for site engineers, project directors, procurement officers, and material suppliers.</p>
        </div>

        <div class="feature-grid-corporate">
            <div class="feature-card-corporate">
                <div class="feature-icon-wrapper">
                    <img src="/images/feature-inventory.svg" alt="Inventory">
                </div>
                <span class="feature-pill-tag">Logistics</span>
                <h3>Material &amp; Stock Hub</h3>
                <p>Live inventory tracking, automated reorder thresholds, site-to-site stock transfers, and material waste auditing.</p>
            </div>

            <div class="feature-card-corporate">
                <div class="feature-icon-wrapper">
                    <img src="/images/vendor-building.svg" alt="Vendors">
                </div>
                <span class="feature-pill-tag">Procurement</span>
                <h3>Vendor &amp; Bidding Directory</h3>
                <p>Multi-vendor price comparison engine, verified contractor directory, legal contract tracking, and disbursement ledgers.</p>
            </div>

            <div class="feature-card-corporate">
                <div class="feature-icon-wrapper">
                    <img src="/images/feature-tracking.svg" alt="Projects">
                </div>
                <span class="feature-pill-tag">Operations</span>
                <h3>Gantt &amp; Labor Logs</h3>
                <p>Interactive milestone progress tracking, daily site engineer logs, weather impact records, and daily wage headcount auditing.</p>
            </div>

            <div class="feature-card-corporate">
                <div class="feature-icon-wrapper">
                    <img src="/images/feature-reports.svg" alt="Reports">
                </div>
                <span class="feature-pill-tag">Finance</span>
                <h3>BOQ &amp; Financial Ledgers</h3>
                <p>Dynamic Bill of Quantities generator with one-click Excel CSV export, project budget versus actual variances, and equipment maintenance schedules.</p>
            </div>
        </div>

        <!-- Featured Construction Projects -->
        <div class="page-header" id="projects" style="margin-top: 1rem;">
            <div>
                <h2 class="page-header-title"><img src="/images/icon-projects.svg" alt="" class="page-header-icon">Featured Construction Sites</h2>
                <p class="page-header-subtitle">Active ongoing infrastructure projects managed on SmartConstruction</p>
            </div>
            <a href="/projects" class="btn btn-secondary btn-sm">View All Projects &rarr;</a>
        </div>

        <div class="projects-portfolio-grid">
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(p => { %>
                    <%
                        let coverImg = '/images/project-commercial.jpg';
                        const pname = (p.name || '').toLowerCase();
                        const ploc = (p.location || '').toLowerCase();
                        if (pname.includes('dhanmondi')) coverImg = '/images/project-dhanmondi.jpg';
                        else if (pname.includes('uttara') || pname.includes('villa')) coverImg = '/images/project-uttara.jpg';
                        else if (pname.includes('highway') || pname.includes('road') || pname.includes('expressway') || ploc.includes('highway') || ploc.includes('expressway')) coverImg = '/images/project-highway.jpg';
                    %>
                    <%
                        let pBadgeClass = 'status-ongoing';
                        if (p.status === 'Completed') pBadgeClass = 'status-good';
                        else if (p.status === 'On Hold') pBadgeClass = 'status-critical';
                        else if (p.status === 'Planning') pBadgeClass = 'status-info';
                    %>
                    <div class="project-corporate-card">
                        <img src="<%= coverImg %>" alt="<%= p.name %> construction site" class="project-image-banner">
                        <div class="project-content">
                            <div class="project-title-row">
                                <h3><%= p.name %></h3>
                                <span class="status-badge <%= pBadgeClass %>"><%= p.status %></span>
                            </div>
                            <p class="project-location">📍 <%= p.location || 'Dhaka, Bangladesh' %></p>
                            <div class="project-footer-row">
                                <div>
                                    <span style="font-size: 0.72rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.04em;">Allocated Budget</span>
                                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 1.15rem; font-weight: 700; color: var(--slate-900);">৳<%= Number(p.budget).toLocaleString() %> BDT</div>
                                </div>
                                <a href="/projects" class="btn btn-secondary btn-sm">Site Overview</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card"><p style="color: var(--slate-500);">No public portfolio projects listed yet.</p></div>
            <% } %>
        </div>

        <!-- Corporate Announcements Board -->
        <div class="page-header">
            <div>
                <h2 class="page-header-title"><img src="/images/icon-notices.svg" alt="" class="page-header-icon">Corporate Bulletins &amp; Notices</h2>
                <p class="page-header-subtitle">Official announcements from executive project directors</p>
            </div>
            <a href="/notices/board" class="btn btn-secondary btn-sm">Full Notice Board &rarr;</a>
        </div>

        <div class="card" style="margin-bottom: 3.5rem;">
            <% if (notices && notices.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Priority</th>
                                <th>Notice Headline</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% notices.forEach(n => { %>
                                <tr>
                                    <td class="table-num"><%= new Date(n.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge <%= n.priority === 'Emergency' ? 'status-critical' : (n.priority === 'High' ? 'status-warning' : 'status-info') %>">
                                            <%= n.priority %>
                                        </span>
                                    </td>
                                    <td><strong><%= n.title %></strong></td>
                                    <td style="color: var(--slate-600);"><%= n.content %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p style="color: var(--slate-500); text-align: center; padding: 1.5rem;">No active bulletins posted today.</p>
            <% } %>
        </div>

        <!-- Closing CTA -->
        <div class="cta-enterprise">
            <h2>Ready to Deploy on Your Construction Sites?</h2>
            <p>Join engineering teams and material suppliers streamlining operations on SmartConstruction.</p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="/login" class="btn btn-brand btn-lg">Access Workspace</a>
                <a href="/register" class="btn btn-secondary btn-on-dark btn-lg">Create New Account</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
