<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h2>🚚 Delivery Scheduling</h2>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Sprint 2 Feature • Member B</p>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Delivery ID</th>
                            <th>PO ID</th>
                            <th>Vendor</th>
                            <th>Expected Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (deliveries && deliveries.length > 0) { %>
                            <% deliveries.forEach(d => { %>
                                <tr>
                                    <td>#<%= d.id %></td>
                                    <td>#<%= d.po_id %></td>
                                    <td><%= d.company_name %></td>
                                    <td><%= d.expected_date ? new Date(d.expected_date).toLocaleDateString() : 'N/A' %></td>
                                    <td>
                                        <span class="status-badge <%= d.status === 'Delivered' ? 'status-good' : (d.status === 'In Transit' ? 'status-moderate' : 'status-lowstock') %>">
                                            <%= d.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (d.status === 'Pending' && (user.role === 'Vendor' || user.role === 'SuperAdmin')) { %>
                                            <form action="/deliveries/status/<%= d.id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="status" value="In Transit">
                                                <button type="submit" class="btn btn-secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Mark In Transit</button>
                                            </form>
                                        <% } %>
                                        <% if (d.status === 'In Transit' && (user.role === 'Site Engineer' || user.role === 'Project Manager' || user.role === 'SuperAdmin')) { %>
                                            <form action="/deliveries/status/<%= d.id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="status" value="Delivered">
                                                <button type="submit" class="btn btn-primary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Receive Delivery</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No deliveries found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
