<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 2rem;">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><img src="/images/icon-contracts.svg" alt="" class="page-header-icon">Vendor Contract Documents</h1>
            <p class="page-header-subtitle">Legal agreements and signed document uploads per supplier.</p>
        </div>
        <% if (user.role === 'SuperAdmin' || user.role === 'Project Manager') { %>
            <div class="header-actions">
                <button class="btn btn-primary" onclick="document.getElementById('uploadModal').style.display='block'">+ Upload Contract</button>
            </div>
        <% } %>
    </div>

    <!-- Modal for Uploading Contract -->
    <div id="uploadModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div class="card" style="width: 92%; max-width: 500px; padding: 2rem; margin: 5% auto; position: relative; max-height: 90vh; overflow-y: auto;">
            <button onclick="document.getElementById('uploadModal').style.display='none'" style="position: absolute; right: 1rem; top: 1rem; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.5rem;">&times;</button>
            <h3>Upload New Contract</h3>
            <form action="/contracts" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div class="form-group">
                    <label>Vendor</label>
                    <select name="vendor_id" class="form-control" required>
                        <% vendors.forEach(v => { %>
                            <option value="<%= v.id %>"><%= v.company_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Document Title</label>
                    <input type="text" name="title" class="form-control" placeholder="e.g., 2026 Material Supply Agreement" required>
                </div>
                <div class="form-group">
                    <label>Contract File (PDF, JPG, PNG)</label>
                    <input type="file" name="contract_file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required style="padding: 0.5rem; background: rgba(20, 87, 153, 0.05); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary);">
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Upload Document</button>
            </form>
        </div>
    </div>

    <div class="card" style="overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>UPLOADED ON</th>
                    <th>VENDOR</th>
                    <th>TITLE</th>
                    <th>UPLOADED BY</th>
                    <th>DOCUMENT</th>
                </tr>
            </thead>
            <tbody>
                <% if (contracts.length === 0) { %>
                    <tr><td colspan="6" style="text-align: center;">No contracts uploaded yet.</td></tr>
                <% } else { %>
                    <% contracts.forEach(c => { %>
                        <tr>
                            <td>#<%= c.id %></td>
                            <td><%= new Date(c.uploaded_at).toLocaleDateString() %></td>
                            <td><%= c.company_name %></td>
                            <td><%= c.title %></td>
                            <td><%= c.uploader_name %></td>
                            <td>
                                <a href="<%= c.file_path %>" target="_blank" class="btn btn-secondary btn-xs">View File</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Close modal if clicked outside
    window.onclick = function(event) {
        if (event.target == document.getElementById('uploadModal')) {
            document.getElementById('uploadModal').style.display = "none";
        }
    }
</script>

<%- include('../partials/footer') %>
</body>
</html>
