<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 780px;">
        <div class="card" style="margin-top: 2rem;">
            <div class="page-header">
                <h2>Edit Project</h2>
                <a href="/projects" class="btn btn-secondary btn-sm">Back</a>
            </div>

            <form action="/projects/edit/<%= project.id %>" method="POST">
                <div class="grid-2">
                    <div class="form-group">
                        <label for="name">Project Name</label>
                        <input type="text" id="name" name="name" value="<%= project.name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="location">Location</label>
                        <input type="text" id="location" name="location" value="<%= project.location || '' %>">
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label for="budget">Budget (BDT)</label>
                        <input type="number" step="0.01" id="budget" name="budget" value="<%= project.budget %>">
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                            <option value="Planning" <%= project.status === 'Planning' ? 'selected' : '' %>>Planning</option>
                            <option value="Ongoing" <%= project.status === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
                            <option value="Completed" <%= project.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                            <option value="On Hold" <%= project.status === 'On Hold' ? 'selected' : '' %>>On Hold</option>
                        </select>
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label for="start_date">Start Date</label>
                        <input type="date" id="start_date" name="start_date" value="<%= project.start_date ? toDateInputValue(project.start_date) : '' %>">
                    </div>
                    <div class="form-group">
                        <label for="target_completion_date">Target Completion Date</label>
                        <input type="date" id="target_completion_date" name="target_completion_date" value="<%= project.target_completion_date ? toDateInputValue(project.target_completion_date) : '' %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Update Project</button>
            </form>

            <a href="/projects" style="display: block; text-align: center; margin-top: 1rem;">&larr; Back to Projects</a>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
