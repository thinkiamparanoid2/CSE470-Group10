<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 2rem;">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><img src="/images/icon-milestones.svg" alt="" class="page-header-icon">Progress Gantt Dashboard</h1>
            <p class="page-header-subtitle">Visual execution timelines and milestone completion by project.</p>
        </div>
    </div>

    <div class="card" style="padding: 2rem;">
        <% if (projects.length === 0) { %>
            <p>No projects found.</p>
        <% } else { %>
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                <% projects.forEach(project => { %>
                    <%
                        let thumbImg = '/images/project-commercial.jpg';
                        const pname2 = (project.name || '').toLowerCase();
                        const ploc2 = (project.location || '').toLowerCase();
                        if (pname2.includes('dhanmondi')) thumbImg = '/images/project-dhanmondi.jpg';
                        else if (pname2.includes('uttara') || pname2.includes('villa')) thumbImg = '/images/project-uttara.jpg';
                        else if (pname2.includes('highway') || pname2.includes('road') || pname2.includes('expressway') || ploc2.includes('highway') || ploc2.includes('expressway')) thumbImg = '/images/project-highway.jpg';
                    %>
                    <div style="background: #FFFFFF; padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
                        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 1rem; gap: 0.75rem 1rem;">
                            <div style="display: flex; align-items: center; gap: 0.85rem; min-width: 0;">
                                <img src="<%= thumbImg %>" alt="" class="project-thumb" style="flex-shrink: 0; width: 44px; height: 44px; border-radius: 8px; object-fit: cover;">
                                <h3 style="margin: 0; font-size: 1.25rem; overflow-wrap: anywhere;"><%= project.name %></h3>
                            </div>
                            <span class="status-badge status-<%= project.status === 'Ongoing' ? 'warning' : (project.status === 'Completed' ? 'good' : 'info') %>" style="flex-shrink: 0;">
                                <%= project.status %>
                            </span>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--slate-500);">
                            <span><strong>Start:</strong> <%= project.formatted_start %></span>
                            <span><strong>Target:</strong> <%= project.formatted_end %></span>
                        </div>

                        <!-- Progress Bar -->
                        <div style="width: 100%; height: 16px; background: var(--slate-100); border-radius: var(--radius-pill); overflow: hidden; margin-bottom: 0.5rem; border: 1px solid var(--border-color);">
                            <div style="width: <%= project.progress %>%; height: 100%; background: linear-gradient(90deg, #2563EB, #60A5FA); border-radius: var(--radius-pill); transition: width 0.5s ease-in-out;"></div>
                        </div>

                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--slate-500);">
                            <span style="font-weight: 700; color: var(--primary-600);"><%= project.progress %>% Complete</span>
                            <span><%= project.completed_milestones %> / <%= project.total_milestones %> Milestones</span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
