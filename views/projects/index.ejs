<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-projects.svg" alt="" class="page-header-icon">Project Portfolio</h1>
                <p class="page-header-subtitle">Active and completed construction sites with budget, schedule, and status.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                <div class="header-actions">
                    <a href="/projects/create" class="btn btn-primary">+ New Project</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Project Name</th>
                            <th>Location</th>
                            <th>Budget (BDT)</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Target Completion</th>
                            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                <th>Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (projects && projects.length > 0) { %>
                            <% projects.forEach((p, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><strong><%= p.name %></strong></td>
                                    <td><%= p.location || 'N/A' %></td>
                                    <td>৳<%= Number(p.budget).toLocaleString() %></td>
                                    <td>
                                        <%
                                            // 'Planning' — a project that simply hasn't broken ground yet — was
                                            // sharing the same red/danger badge as 'On Hold', which genuinely does
                                            // signal a stalled project needing attention. A not-yet-started
                                            // project shouldn't read as a problem.
                                            let pBadgeClass = 'status-ongoing';
                                            if (p.status === 'Completed') pBadgeClass = 'status-good';
                                            else if (p.status === 'On Hold') pBadgeClass = 'status-critical';
                                            else if (p.status === 'Planning') pBadgeClass = 'status-info';
                                        %>
                                        <span class="status-badge <%= pBadgeClass %>">
                                            <%= p.status %>
                                        </span>
                                    </td>
                                    <td><%= p.start_date ? new Date(p.start_date).toLocaleDateString() : 'N/A' %></td>
                                    <td><%= p.target_completion_date ? new Date(p.target_completion_date).toLocaleDateString() : 'N/A' %></td>
                                    <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                        <td>
                                            <div style="display: flex; gap: 0.4rem;">
                                                <a href="/projects/edit/<%= p.id %>" class="btn btn-secondary btn-xs">Edit</a>
                                                <form action="/projects/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this project?')">
                                                    <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="8" style="text-align: center; color: var(--text-muted);">No projects found. Create one to get started.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
