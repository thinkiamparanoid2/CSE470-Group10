<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; }
        .form-row .form-group { flex: 1; min-width: 0; }
        .item-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 1rem; background: rgba(20, 87, 153, 0.08); padding: 1rem; border-radius: 8px; }
        .item-row .form-group { min-width: 140px; }
        .remove-btn { background: var(--accent-red); color: #fff; border: 1px solid var(--accent-red); }

        @media (max-width: 560px) {
            .form-row { flex-direction: column; gap: 0; }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 800px;">
        <h2>Create Purchase Order</h2>
        <div class="card" style="margin-top: 2rem;">
            <form action="/purchase_orders/create" method="POST">
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Vendor</label>
                        <select name="vendor_id" required>
                            <option value="">Select a Vendor</option>
                            <% vendors.forEach(v => { %>
                                <option value="<%= v.id %>"><%= v.company_name %> (Rating: <%= v.rating %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Expected Delivery Date</label>
                        <input type="date" name="expected_date" required>
                    </div>
                </div>

                <hr style="border: 1px solid rgba(20, 87, 153, 0.12); margin: 2rem 0;">
                
                <h3 style="margin-bottom: 1rem;">Order Items</h3>
                <div id="items-container">
                    <div class="item-row">
                        <div class="form-group" style="flex: 2;">
                            <label>Material</label>
                            <select name="material_id" required>
                                <option value="">Select Material</option>
                                <% materials.forEach(m => { %>
                                    <option value="<%= m.id %>"><%= m.name %> (Est. ৳<%= m.unit_price_est %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="number" step="0.01" name="quantity" required placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label>Unit Price (৳)</label>
                            <input type="number" step="0.01" name="unit_price" required placeholder="0.00">
                        </div>
                    </div>
                </div>
                
                <button type="button" class="btn btn-secondary" onclick="addItem()" style="margin-bottom: 2rem;">+ Add Another Item</button>

                <div class="form-actions-row">
                    <button type="submit" class="btn btn-primary">Generate Purchase Order</button>
                    <a href="/purchase_orders" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function addItem() {
            const container = document.getElementById('items-container');
            const row = document.createElement('div');
            row.className = 'item-row';
            row.innerHTML = `
                <div class="form-group" style="flex: 2;">
                    <select name="material_id" required>
                        <option value="">Select Material</option>
                        <% materials.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (Est. ৳<%= m.unit_price_est %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <input type="number" step="0.01" name="quantity" required placeholder="Qty">
                </div>
                <div class="form-group">
                    <input type="number" step="0.01" name="unit_price" required placeholder="Price">
                </div>
                <button type="button" class="btn remove-btn" onclick="this.parentElement.remove()">X</button>
            `;
            container.appendChild(row);
        }
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
