<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/vendor-building.svg" alt="" class="page-header-icon">Vendor Directory &amp; Ratings</h1>
                <p class="page-header-subtitle">Verified suppliers, contact details, and performance ratings for procurement.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                <div class="header-actions">
                    <a href="/vendors/create" class="btn btn-primary">+ Add New Supplier</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Company Name</th>
                            <th>Contact Person</th>
                            <th>Supply Category</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Rating</th>
                            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                <th>Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendors && vendors.length > 0) { %>
                            <% vendors.forEach(v => { %>
                                <tr>
                                    <td>
                                        <div class="row-with-icon">
                                            <img src="/images/vendor-building.svg" alt="" class="icon-badge">
                                            <strong><%= v.company_name %></strong>
                                        </div>
                                    </td>
                                    <td><%= v.contact_person || 'N/A' %></td>
                                    <td><%= v.material_category %></td>
                                    <td><%= v.phone %></td>
                                    <td><%= v.email || 'N/A' %></td>
                                    <td>⭐ <%= v.rating %> / 5.0</td>
                                    <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                        <td>
                                            <div style="display: flex; gap: 0.4rem;">
                                                <a href="/vendors/edit/<%= v.id %>" class="btn btn-secondary btn-xs">Edit</a>
                                                <form action="/vendors/delete/<%= v.id %>" method="POST">
                                                    <button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('Delete this vendor?');">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No vendors registered yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
