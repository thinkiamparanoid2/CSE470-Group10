<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .print-only {
            display: none;
        }
        @media print {
            .no-print, .add-item-form, .btn {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .print-header-box {
                border-bottom: 2px solid #000;
                padding-bottom: 15px;
                margin-bottom: 20px;
            }
            .print-meta-table {
                width: 100% !important;
                margin-bottom: 25px !important;
                border: none !important;
            }
            .print-meta-table td {
                border: none !important;
                padding: 4px 0 !important;
                font-size: 11pt !important;
            }
            .signature-section {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-between !important;
                margin-top: 70px !important;
                page-break-inside: avoid;
            }
            .signature-block {
                width: 260px;
                text-align: center;
                border-top: 1px solid #000 !important;
                padding-top: 8px;
                font-size: 10pt;
            }
            /* Override grid colors for crisp black & white printing */
            .grid-3 h3, .grid-3 p {
                color: #000 !important;
            }
            .grand-total-row td {
                background-color: #f8f8f8 !important;
                font-weight: bold !important;
                border-top: 2px solid #000 !important;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <!-- Professional Corporate Print Letterhead (Hidden on Web, Visible in PDF) -->
        <div class="print-only print-header-box">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:6px;">
                <img src="/images/logo-mark.svg" alt="" class="letterhead-logo">
                <h2 style="margin: 0; font-size: 18pt; text-transform: uppercase; letter-spacing: 0.5px;">SmartConstruction Engineering & Infrastructure Ltd.</h2>
            </div>
            <h3 style="margin: 5px 0 0 0; font-size: 13pt; color: #333; font-weight: 600;">Official Bill of Quantities (BOQ) Tender & Cost Forecast Worksheet</h3>
        </div>

        <div class="print-only">
            <table class="print-meta-table">
                <tr>
                    <td style="width: 15%;"><strong>Project Name:</strong></td>
                    <td style="width: 45%;"><%= boq.project_name %></td>
                    <td style="width: 20%;"><strong>Document Ref:</strong></td>
                    <td style="width: 20%;">#BOQ-<%= boq.id %>-2026</td>
                </tr>
                <tr>
                    <td><strong>Worksheet Title:</strong></td>
                    <td><%= boq.title %></td>
                    <td><strong>Date Generated:</strong></td>
                    <td><%= new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                </tr>
                <tr>
                    <td><strong>Prepared By:</strong></td>
                    <td><%= boq.created_by_name || 'Senior Estimating Engineer' %></td>
                    <td><strong>Status:</strong></td>
                    <td>APPROVED FOR EVALUATION</td>
                </tr>
            </table>
        </div>

        <!-- Web Interface Header (Hidden in PDF) -->
        <div class="page-header no-print">
            <div>
                <h2>BOQ Worksheet: <%= boq.title %></h2>
                <p style="color: var(--text-muted);">Project: <strong><%= boq.project_name %></strong> | Created By: <%= boq.created_by_name || 'System' %></p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button onclick="window.print()" class="btn btn-secondary">🖨️ Print / Save as PDF</button>
                <a href="/boq/<%= boq.id %>/export-csv" class="btn btn-primary">📊 Export Excel (CSV)</a>
                <a href="/boq" class="btn btn-secondary">&larr; Back</a>
            </div>
        </div>

        <!-- Financial Summary Grid -->
        <div class="grid-3" style="margin-bottom: 1.5rem;">
            <div class="card" style="border-left: 4px solid var(--accent-blue);">
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.2rem;">Project Approved Budget</p>
                <h3 style="font-size: 1.5rem;">৳<%= parseFloat(boq.project_budget || 0).toLocaleString() %></h3>
            </div>
            <div class="card" style="border-left: 4px solid var(--accent-green);">
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.2rem;">BOQ Estimated Forecast Cost</p>
                <h3 style="font-size: 1.5rem; color: var(--accent-green);">৳<%= totalCost.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></h3>
            </div>
            <div class="card" style="border-left: 4px solid <%= (parseFloat(boq.project_budget) - totalCost) < 0 ? 'var(--accent-red)' : 'var(--accent-amber)' %>;">
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.2rem;">Estimated Budget Variance</p>
                <h3 style="font-size: 1.5rem; color: <%= (parseFloat(boq.project_budget) - totalCost) < 0 ? 'var(--accent-red)' : 'inherit' %>;">
                    ৳<%= (parseFloat(boq.project_budget) - totalCost).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                </h3>
            </div>
        </div>

        <% if (boq.notes) { %>
            <div class="card" style="margin-bottom: 1.5rem; background: rgba(20, 87, 153, 0.06);">
                <strong style="font-size: 1.05rem;">Technical Scope & Estimating Assumptions:</strong>
                <p style="margin-top: 0.4rem; color: var(--text-light); line-height: 1.5; white-space: pre-line;"><%= boq.notes %></p>
            </div>
        <% } %>

        <!-- BOQ Items Table -->
        <div class="card" style="margin-top: 1rem;">
            <h3 style="margin-bottom: 0.8rem;">Forecasted Construction Material & Requirement Schedule</h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 15%;">Category</th>
                            <th style="width: 35%;">Material / Item Description</th>
                            <th style="width: 10%;">Unit</th>
                            <th style="width: 12%; text-align: right;">Estimated Quantity</th>
                            <th style="width: 13%; text-align: right;">Estimated Rate (৳)</th>
                            <th style="width: 15%; text-align: right;">Total Amount (৳)</th>
                            <th class="no-print" style="width: 8%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (items.length > 0) { %>
                            <% items.forEach((item, idx) => { %>
                                <tr>
                                    <td><%= idx + 1 %></td>
                                    <td><span class="status-badge status-good" style="font-size: 0.75rem;"><%= item.item_category %></span></td>
                                    <td><strong><%= item.material_name %></strong></td>
                                    <td><%= item.unit %></td>
                                    <td style="text-align: right;"><%= parseFloat(item.quantity_estimated).toLocaleString() %></td>
                                    <td style="text-align: right;">৳<%= parseFloat(item.unit_price_estimated).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                    <td style="text-align: right; font-weight: 600;">
                                        ৳<%= item.total_item_price.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                    </td>
                                    <td class="no-print">
                                        <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                                            <form action="/boq/delete-item/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Remove this item from BOQ?');">
                                                <input type="hidden" name="boq_id" value="<%= boq.id %>">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                            <tr class="grand-total-row" style="background: rgba(20, 87, 153, 0.08); font-size: 1.08rem;">
                                <td colspan="6" style="text-align: right; font-weight: 700;">Grand Total Forecast Cost:</td>
                                <td style="text-align: right; color: var(--accent-green); font-weight: 700;">
                                    ৳<%= totalCost.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                </td>
                                <td class="no-print"></td>
                            </tr>
                        <% } else { %>
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                    No items added to this BOQ yet. Use the quick form below to add construction material estimates.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Corporate Signature Block (Only in PDF printout) -->
        <div class="print-only signature-section">
            <div class="signature-block">
                <strong>Prepared By (Estimating Engineer)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
            <div class="signature-block">
                <strong>Checked By (Site Engineer)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
            <div class="signature-block">
                <strong>Approved By (Project Manager / Director)</strong><br>
                <span style="color: #444; font-size: 9.5pt;">Signature & Date</span>
            </div>
        </div>
        <div class="print-only" style="margin-top: 35px; font-size: 8.5pt; color: #666; border-top: 1px solid #ddd; padding-top: 8px;">
            <em>Notice: This document contains proprietary engineering structural estimates and cost projections generated via SmartConstruction Platform. All unit rates are estimated and subject to market quotation updates.</em>
        </div>

        <!-- Add Item Form (Only in view, hidden during print) -->
        <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager' || user.role === 'Site Engineer')) { %>
            <div class="card no-print add-item-form" style="margin-top: 1.5rem;">
                <h3>➕ Add Forecast Item to BOQ</h3>
                <form action="/boq/<%= boq.id %>/add-item" method="POST" style="margin-top: 1rem;">
                    <div class="grid-3">
                        <div class="form-group">
                            <label>Quick Select from Materials Catalog:</label>
                            <select id="catalog_select" class="form-control" onchange="fillMaterialDetails()">
                                <option value="">-- Or enter custom below --</option>
                                <% materials.forEach(m => { %>
                                    <option value="<%= m.name %>" data-category="<%= m.category %>" data-unit="<%= m.unit %>" data-price="<%= m.unit_price_est %>">
                                        <%= m.name %> (Est: ৳<%= m.unit_price_est %> / <%= m.unit %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="material_name">Material / Item Name:</label>
                            <input type="text" name="material_name" id="material_name" class="form-control" required placeholder="e.g., Deformed Rod 500W">
                        </div>
                        <div class="form-group">
                            <label for="item_category">Category:</label>
                            <input type="text" name="item_category" id="item_category" class="form-control" value="Steel/Rod" placeholder="Cement / Bricks / Steel / Sand">
                        </div>
                    </div>

                    <div class="grid-3" style="margin-top: 1rem;">
                        <div class="form-group">
                            <label for="unit">Unit:</label>
                            <input type="text" name="unit" id="unit" class="form-control" required placeholder="Tons / Bags / Pcs / Cft">
                        </div>
                        <div class="form-group">
                            <label for="quantity_estimated">Estimated Quantity Required:</label>
                            <input type="number" step="0.01" name="quantity_estimated" id="quantity_estimated" class="form-control" required placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label for="unit_price_estimated">Estimated Unit Price (৳):</label>
                            <input type="number" step="0.01" name="unit_price_estimated" id="unit_price_estimated" class="form-control" required placeholder="0.00">
                        </div>
                    </div>

                    <div style="margin-top: 1rem; text-align: right;">
                        <button type="submit" class="btn btn-primary">Add Item to Worksheet &rarr;</button>
                    </div>
                </form>
            </div>
        <% } %>
    </div>

    <script>
        function fillMaterialDetails() {
            const select = document.getElementById('catalog_select');
            if (select.selectedIndex <= 0) return;
            const option = select.options[select.selectedIndex];
            document.getElementById('material_name').value = option.value;
            document.getElementById('item_category').value = option.getAttribute('data-category') || 'Material';
            document.getElementById('unit').value = option.getAttribute('data-unit') || 'Unit';
            document.getElementById('unit_price_estimated').value = option.getAttribute('data-price') || 0;
        }
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
