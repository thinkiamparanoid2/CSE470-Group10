<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-boq.svg" alt="" class="page-header-icon">Bill of Quantities (BOQ) Generator</h1>
                <p class="page-header-subtitle">Itemized cost worksheets per project with one-click Excel export.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager' || user.role === 'Site Engineer')) { %>
                <div class="header-actions">
                    <a href="/boq/create" class="btn btn-primary">+ Create New BOQ</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <h3>All Project BOQ Forecasts</h3>
            <div class="table-responsive" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>BOQ #</th>
                            <th>Title</th>
                            <th>Project Site</th>
                            <th>Total Forecast Cost</th>
                            <th>Created By</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (boqs && boqs.length > 0) { %>
                            <% boqs.forEach(boq => { %>
                                <tr>
                                    <td><strong>#BOQ-<%= boq.id %></strong></td>
                                    <td><%= boq.title %></td>
                                    <td><%= boq.project_name %></td>
                                    <td style="font-weight: bold; color: var(--accent-green);">
                                        ৳<%= parseFloat(boq.total_estimated_cost).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                    </td>
                                    <td><%= boq.created_by_name || 'System' %></td>
                                    <td><%= new Date(boq.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <a href="/boq/<%= boq.id %>" class="btn btn-secondary btn-xs">Worksheet</a>
                                            <a href="/boq/<%= boq.id %>/export-csv" class="btn btn-primary btn-xs">📊 Excel CSV</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 2rem;">
                                        No Bill of Quantities created yet. Click "+ Create New BOQ" above to begin estimation.
                                    </td>
                                </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
