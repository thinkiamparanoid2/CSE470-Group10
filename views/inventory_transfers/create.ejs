<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 600px;">
        <h2>Request Material Transfer</h2>
        <div class="card" style="margin-top: 2rem;">
            <form action="/inventory-transfers/create" method="POST">
                
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Material</label>
                    <select name="material_id" required style="width: 100%; padding: 0.5rem;">
                        <option value="">Select Material</option>
                        <% materials.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.current_stock %> <%= m.unit %> in Global Stock)</option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Quantity to Transfer</label>
                    <input type="number" step="0.01" name="quantity" required placeholder="e.g. 50" style="width: 100%; padding: 0.5rem;">
                </div>
                
                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                    <div class="form-group" style="flex: 1;">
                        <label>From Project</label>
                        <select name="from_project_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Origin Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>To Project</label>
                        <select name="to_project_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Destination Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">Submit Request</button>
                    <a href="/inventory-transfers" class="btn btn-secondary" style="flex: 1; text-align: center;">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
