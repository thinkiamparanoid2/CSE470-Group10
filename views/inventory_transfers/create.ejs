<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="max-width: 780px;">
        <div class="card" style="margin-top: 2rem;">
            <h2 class="page-header-title" style="margin-bottom: 0.35rem;"><img src="/images/icon-transfers.svg" alt="" class="page-header-icon" style="width: 30px; height: 30px;">Request Material Transfer</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Move stock between two active construction sites.</p>

            <form action="/inventory-transfers/create" method="POST">
                <div class="grid-2">
                    <div class="form-group">
                        <label>Material</label>
                        <select name="material_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Material</option>
                            <% materials.forEach(m => { %>
                                <option value="<%= m.id %>"><%= m.name %> (<%= m.current_stock %> <%= m.unit %> in Global Stock)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Quantity to Transfer</label>
                        <input type="number" step="0.01" name="quantity" required placeholder="e.g. 50" style="width: 100%; padding: 0.5rem;">
                    </div>
                </div>

                <div class="grid-2" style="margin-bottom: 0.5rem;">
                    <div class="form-group">
                        <label>From Project</label>
                        <select name="from_project_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Origin Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>To Project</label>
                        <select name="to_project_id" required style="width: 100%; padding: 0.5rem;">
                            <option value="">Select Destination Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="form-actions-row">
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                    <a href="/inventory-transfers" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
