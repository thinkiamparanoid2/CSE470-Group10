<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <div>
                <h1 class="page-header-title"><img src="/images/icon-notices.svg" alt="" class="page-header-icon">Notice Board CMS</h1>
                <p class="page-header-subtitle">Publish and manage company-wide announcements and alerts.</p>
            </div>
            <% if (user && (user.role === 'SuperAdmin' || user.role === 'Project Manager')) { %>
                <div class="header-actions">
                    <a href="/notices/create" class="btn btn-primary">+ Create Notice</a>
                </div>
            <% } %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Priority</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (notices && notices.length > 0) { %>
                            <% notices.forEach(n => { %>
                                <tr>
                                    <td><%= new Date(n.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge <%= n.priority === 'Emergency' ? 'status-lowstock' : (n.priority === 'High' ? 'status-moderate' : 'status-good') %>">
                                            <%= n.priority %>
                                        </span>
                                    </td>
                                    <td><strong><%= n.title %></strong></td>
                                    <td><%= n.author || 'System Admin' %></td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <a href="/notices/edit/<%= n.id %>" class="btn btn-secondary btn-xs">Edit</a>
                                            <form action="/notices/delete/<%= n.id %>" method="POST">
                                                <button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('Delete this notice?');">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5">No notices have been published.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
